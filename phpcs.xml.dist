<?xml version="1.0"?>
<ruleset name="LPS WordPress">
	<description>WordPress coding standards for LPS-owned PHP.</description>
	<file>wp-content/plugins/lps-content-model</file>
	<file>wp-content/themes/lps-theme</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<arg name="extensions" value="php" />
	<arg name="basepath" value="." />
	<config name="installed_paths" value="vendor/wp-coding-standards/wpcs,vendor/phpcsstandards/phpcsextra,vendor/phpcsstandards/phpcsutils" />
	<rule ref="WordPress">
		<!-- PHP.wasm cannot spawn the external `php -l` process; PHPStan performs syntax analysis. -->
		<exclude name="Generic.PHP.Syntax" />
	</rule>
	<!-- PHPUnit conventions differ from production code: CamelCase Test.php
	     filenames and test_* methods are required, fixtures fabricate request
	     input, and filesystem helpers manage temp dirs. Narrow the WP-
	     production-specific sniffs inside */tests/ only; production code keeps
	     every check. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.FunctionComment">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.ClassComment">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting.DocComment">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DevelopmentFunctions">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.ValidVariableName">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.NonceVerification">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.DB.SlowDBQuery">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.PostsPerPage">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Files.OneObjectStructurePerFile">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
</ruleset>

