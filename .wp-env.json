  "$schema": "https://schemas.wp.org/trunk/wp-env.json",
  "core": "./.cache/wordpress",
  "phpVersion": "8.3",
  "port": 8888,
  "testsEnvironment": false,
  "plugins": [
    "./wp-content/plugins/lps-content-model",
    "./.cache/wp-plugins/polylang",
    "./.cache/wp-plugins/two-factor"
