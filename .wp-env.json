    "wp-content/mu-plugins/lps-search-seed.php": "./tests/fixtures/wp/lps-search-seed.php",
    "wp-content/mu-plugins/lps-trust-seed.php": "./tests/fixtures/wp/lps-trust-seed.php",
    "wp-content/mu-plugins/lps-seo-seed.php": "./tests/fixtures/wp/lps-seo-seed.php",
    "wp-content/mu-plugins/lps-a11y-seed.php": "./tests/fixtures/wp/lps-a11y-seed.php",
