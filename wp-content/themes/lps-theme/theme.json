{
  "$schema": "https://schemas.wp.org/wp/6.9/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "68ch",
      "wideSize": "80rem"
    },
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        { "slug": "paper", "name": "Paper", "color": "#F7F4EC" },
        { "slug": "paper-raised", "name": "Paper raised", "color": "#FFFEFA" },
        { "slug": "paper-muted", "name": "Paper muted", "color": "#ECE8DE" },
        { "slug": "ink", "name": "Ink", "color": "#141A1F" },
        { "slug": "ink-soft", "name": "Ink soft", "color": "#46515A" },
        { "slug": "navy", "name": "Navy", "color": "#003B5C" },
        { "slug": "navy-hover", "name": "Navy hover", "color": "#002B44" },
        { "slug": "signal", "name": "Signal", "color": "#007A87" },
        { "slug": "signal-hover", "name": "Signal hover", "color": "#005F69" },
        { "slug": "rule", "name": "Rule", "color": "#C9CDD1" },
        { "slug": "rule-strong", "name": "Rule strong", "color": "#6F7A82" },
        { "slug": "success", "name": "Success", "color": "#216E4E" },
        { "slug": "warning", "name": "Warning", "color": "#7A4A00" },
        { "slug": "error", "name": "Error", "color": "#A12622" },
        { "slug": "info-wash", "name": "Info wash", "color": "#DDECEF" },
        { "slug": "success-wash", "name": "Success wash", "color": "#E0ECE5" }
      ]
    },
    "spacing": {
      "customSpacingSize": false,
      "defaultSpacingSizes": false,
      "spacingScale": { "steps": 0 },
      "spacingSizes": [
        { "slug": "1", "name": "1", "size": "0.25rem" },
        { "slug": "2", "name": "2", "size": "0.5rem" },
        { "slug": "3", "name": "3", "size": "0.75rem" },
        { "slug": "4", "name": "4", "size": "1rem" },
        { "slug": "5", "name": "5", "size": "1.25rem" },
        { "slug": "6", "name": "6", "size": "1.5rem" },
        { "slug": "8", "name": "8", "size": "2rem" },
        { "slug": "10", "name": "10", "size": "2.5rem" },
        { "slug": "12", "name": "12", "size": "3rem" },
        { "slug": "16", "name": "16", "size": "4rem" },
        { "slug": "20", "name": "20", "size": "5rem" },
        { "slug": "24", "name": "24", "size": "6rem" }
      ],
      "units": ["rem", "%", "vw", "vh"]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "dropCap": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "editorial",
          "name": "Source Serif 4",
          "fontFamily": "\"Source Serif 4\", \"Noto Serif\", \"Noto Serif CJK SC\", \"Noto Serif CJK JP\", Georgia, serif",
          "fontFace": [
            { "fontFamily": "Source Serif 4", "fontStyle": "normal", "fontWeight": "400", "src": ["file:./assets/fonts/source-serif-4-regular.woff2"] },
            { "fontFamily": "Source Serif 4", "fontStyle": "normal", "fontWeight": "600 700", "src": ["file:./assets/fonts/source-serif-4-semibold.woff2"] }
          ]
        },
        { "slug": "interface", "name": "Interface", "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif" },
        { "slug": "mono", "name": "Technical metadata", "fontFamily": "ui-monospace, \"Cascadia Mono\", \"Segoe UI Mono\", Menlo, Consolas, monospace" }
      ],
      "fontSizes": [
        { "slug": "meta", "name": "Metadata", "size": "0.75rem" },
        { "slug": "small", "name": "Small", "size": "0.875rem" },
        { "slug": "body", "name": "Body", "size": "1rem", "fluid": false },
        { "slug": "reading", "name": "Reading", "size": "1.125rem" },
        { "slug": "lead", "name": "Lead", "size": "clamp(1.25rem, 2vw, 1.5rem)" },
        { "slug": "h4", "name": "Heading 4", "size": "1.125rem" },
        { "slug": "h3", "name": "Heading 3", "size": "clamp(1.375rem, 2vw, 1.75rem)" },
        { "slug": "h2", "name": "Heading 2", "size": "clamp(1.75rem, 3.5vw, 2.75rem)" },
        { "slug": "h1", "name": "Heading 1", "size": "clamp(2.25rem, 5vw, 4rem)" },
        { "slug": "display", "name": "Display", "size": "clamp(2.75rem, 7vw, 5.75rem)" }
      ]
    },
    "border": { "color": false, "radius": false, "style": false, "width": false },
    "shadow": { "defaultPresets": false, "presets": [] },
    "blocks": {
      "core/button": { "border": { "radius": false }, "color": { "custom": false } },
      "core/group": { "color": { "custom": false }, "spacing": { "padding": true, "margin": true } },
      "core/image": { "border": { "radius": false } }
    }
  },
  "styles": {
    "color": { "background": "var:preset|color|paper", "text": "var:preset|color|ink" },
    "spacing": { "blockGap": "var:preset|spacing|6" },
    "typography": { "fontFamily": "var:preset|font-family|interface", "fontSize": "var:preset|font-size|body", "lineHeight": "1.65" },
    "elements": {
      "heading": { "color": { "text": "var:preset|color|ink" }, "typography": { "fontFamily": "var:preset|font-family|editorial", "fontWeight": "600" } },
      "link": { "color": { "text": "var:preset|color|signal-hover" }, "typography": { "textDecoration": "underline" } },
      "button": { "border": { "radius": "0" }, "color": { "background": "var:preset|color|navy", "text": "var:preset|color|paper-raised" }, "typography": { "fontFamily": "var:preset|font-family|interface", "fontSize": "var:preset|font-size|small", "fontWeight": "700" } }
    }
  },
  "templateParts": [
    { "area": "header", "name": "header", "title": "Institutional header" },
    { "area": "footer", "name": "footer", "title": "Institutional footer" }
  ]
}
