{
  "$schema": "https://schemas.wp.org/wp/6.9/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "68ch",
      "wideSize": "80rem"
    },
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        { "slug": "canvas", "name": "Canvas", "color": "#F5F7FA" },
        { "slug": "surface", "name": "Surface", "color": "#FFFFFF" },
        { "slug": "anchor", "name": "Institutional anchor", "color": "#12304A" },
        { "slug": "anchor-deep", "name": "Anchor depth", "color": "#0C2237" },
        { "slug": "action", "name": "Action", "color": "#165A96" },
        { "slug": "action-hover", "name": "Action depth", "color": "#0F4A7E" },
        { "slug": "text", "name": "Text", "color": "#182B3A" },
        { "slug": "text-muted", "name": "Muted text", "color": "#526477" },
        { "slug": "rule-quiet", "name": "Quiet rule", "color": "#D7E0E8" },
        { "slug": "boundary-strong", "name": "Strong boundary", "color": "#74869A" },
        { "slug": "success", "name": "Success", "color": "#216E4E" },
        { "slug": "warning", "name": "Warning", "color": "#7A4A00" },
        { "slug": "error", "name": "Error", "color": "#A12622" },
        { "slug": "info-wash", "name": "Info wash", "color": "#DDECEF" },
        { "slug": "success-wash", "name": "Success wash", "color": "#E0ECE5" },
        { "slug": "warning-wash", "name": "Warning wash", "color": "#F2E8D2" },
        { "slug": "error-wash", "name": "Error wash", "color": "#F2DEDA" }
      ]
    },
    "spacing": {
      "customSpacingSize": false,
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "1", "name": "1", "size": "0.25rem" },
        { "slug": "2", "name": "2", "size": "0.5rem" },
        { "slug": "3", "name": "3", "size": "0.75rem" },
        { "slug": "4", "name": "4", "size": "1rem" },
        { "slug": "5", "name": "5", "size": "1.25rem" },
        { "slug": "6", "name": "6", "size": "1.5rem" },
        { "slug": "8", "name": "8", "size": "2rem" },
        { "slug": "10", "name": "10", "size": "2.5rem" },
        { "slug": "12", "name": "12", "size": "3rem" },
        { "slug": "16", "name": "16", "size": "4rem" },
        { "slug": "20", "name": "20", "size": "5rem" },
        { "slug": "24", "name": "24", "size": "6rem" }
      ],
      "units": ["rem", "%", "vw", "vh"]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "dropCap": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "interface",
          "name": "IBM Plex Sans",
          "fontFamily": "\"IBM Plex Sans\", system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
          "fontFace": [
            {
              "fontFamily": "IBM Plex Sans",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/ibm-plex-sans-regular.woff2"]
            },
            {
              "fontFamily": "IBM Plex Sans",
              "fontStyle": "normal",
              "fontWeight": "450 550",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/ibm-plex-sans-medium.woff2"]
            },
            {
              "fontFamily": "IBM Plex Sans",
              "fontStyle": "normal",
              "fontWeight": "600 650",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/ibm-plex-sans-semibold.woff2"]
            },
            {
              "fontFamily": "IBM Plex Sans",
              "fontStyle": "normal",
              "fontWeight": "700 750",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/ibm-plex-sans-bold.woff2"]
            }
          ]
        },
        {
          "slug": "mono",
          "name": "IBM Plex Mono",
          "fontFamily": "\"IBM Plex Mono\", ui-monospace, \"Cascadia Mono\", \"Segoe UI Mono\", Menlo, Consolas, monospace",
          "fontFace": [
            {
              "fontFamily": "IBM Plex Mono",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/ibm-plex-mono-regular.woff2"]
            },
            {
              "fontFamily": "IBM Plex Mono",
              "fontStyle": "normal",
              "fontWeight": "500 700",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/ibm-plex-mono-semibold.woff2"]
            }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "meta", "name": "Metadata", "size": "0.75rem" },
        { "slug": "small", "name": "Small", "size": "0.875rem" },
        { "slug": "body", "name": "Body", "size": "1rem", "fluid": false },
        { "slug": "reading", "name": "Reading", "size": "1.125rem" },
        { "slug": "lead", "name": "Lead", "size": "clamp(1.125rem, 1.6vw, 1.25rem)" },
        { "slug": "h4", "name": "Heading 4", "size": "1.125rem" },
        { "slug": "h3", "name": "Heading 3", "size": "clamp(1.125rem, 1.8vw, 1.375rem)" },
        { "slug": "h2", "name": "Heading 2", "size": "clamp(1.375rem, 2.5vw, 2rem)" },
        { "slug": "h1", "name": "Heading 1", "size": "clamp(1.75rem, 4vw, 2.75rem)" },
        { "slug": "display", "name": "Display", "size": "clamp(2rem, 5vw, 3.5rem)" }
      ]
    },
    "border": { "color": false, "radius": false, "style": false, "width": false },
    "shadow": { "defaultPresets": false, "presets": [] },
    "blocks": {
      "core/button": { "border": { "radius": false }, "color": { "custom": false } },
      "core/group": {
        "color": { "custom": false },
        "spacing": { "padding": true, "margin": true }
      },
      "core/image": { "border": { "radius": false } }
    }
  },
  "styles": {
    "color": { "background": "var:preset|color|canvas", "text": "var:preset|color|text" },
    "spacing": { "blockGap": "var:preset|spacing|6" },
    "typography": {
      "fontFamily": "var:preset|font-family|interface",
      "fontSize": "var:preset|font-size|body",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "color": { "text": "var:preset|color|text" },
        "typography": { "fontFamily": "var:preset|font-family|interface" }
      },
      "h1": {
        "typography": {
          "fontFamily": "var:preset|font-family|interface",
          "fontSize": "var:preset|font-size|h1",
          "fontWeight": "700",
          "lineHeight": "1.15"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var:preset|font-family|interface",
          "fontSize": "var:preset|font-size|h2",
          "fontWeight": "650",
          "lineHeight": "1.2"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var:preset|font-family|interface",
          "fontSize": "var:preset|font-size|h3",
          "fontWeight": "650",
          "lineHeight": "1.25"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var:preset|font-family|interface",
          "fontSize": "var:preset|font-size|h4",
          "fontWeight": "650",
          "lineHeight": "1.3"
        }
      },
      "link": {
        "color": { "text": "var:preset|color|action" },
        "typography": { "textDecoration": "underline" }
      },
      "button": {
        "border": { "radius": "4px" },
        "color": { "background": "var:preset|color|action", "text": "var:preset|color|surface" },
        "typography": {
          "fontFamily": "var:preset|font-family|interface",
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "700"
        }
      }
    },
    "blocks": {
      "core/post-content": {
        "typography": {
          "fontFamily": "var:preset|font-family|interface",
          "fontSize": "var:preset|font-size|reading",
          "lineHeight": "1.65"
        }
      }
    }
  },
  "templateParts": [
    { "area": "header", "name": "header", "title": "Institutional header" },
    { "area": "footer", "name": "footer", "title": "Institutional footer" }
  ]
}
