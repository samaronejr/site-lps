{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "files": {
    "includes": [
      "**",
      "!!dist",
      "!!showcase/institutional-redesign/public",
      "!!node_modules",
      "!!vendor",
      "!!.agents",
      "!!.wp-env",
      "!!.cache",
      "!!content/import",
      "!!.omo",
      "!!playwright-report",
      "!!test-results",
      "!!tests/fixtures/a11y"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "json": {
    "parser": {
      "allowComments": false
    }
  }
}
