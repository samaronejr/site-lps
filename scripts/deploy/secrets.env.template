# LPS staging secrets — copy to <staging-root>/ops/secrets.env, mode 0600.
# The deploy halts when this file is missing, unreadable, or a required key is
# empty. Never commit a real secrets.env; never reuse production values here.
#
# Bearer token required on the edge purge endpoint (POST /lps-ops/purge).
LPS_PURGE_TOKEN=
# Absolute path of the alert sink the monitor appends JSON alert records to.
# On the institution-managed host this is the alertmanager webhook; on the
# staging runtime it is <staging-root>/ops/logs/alerts.jsonl.
LPS_ALERT_SINK=
# Optional: password assigned to the bootstrapped admin account at provision
# time. When empty the deploy generates one and stores it only in secrets.env.
LPS_ADMIN_PASSWORD=
