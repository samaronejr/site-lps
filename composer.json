{
  "name": "lps/lps-institutional-website",
  "description": "PHP quality gates for the LPS WordPress plugin and theme.",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require": { "php": "8.3.*" },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "1.2.1",
    "php-stubs/wordpress-stubs": "v6.9.4",
    "phpstan/phpstan": "2.2.10",
    "phpunit/phpunit": "11.5.56",
    "wp-coding-standards/wpcs": "3.4.1"
  },
  "config": {
    "allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": true },
    "optimize-autoloader": true,
    "platform": { "php": "8.3.6" },
    "sort-packages": true
  },
  "scripts": {
    "lint": "@php vendor/bin/phpcs --standard=phpcs.xml.dist",
    "analyse": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --no-progress",
    "test": "@php vendor/bin/phpunit --configuration=phpunit.xml.dist"
  }
}
